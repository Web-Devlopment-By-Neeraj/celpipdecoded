# Copy this file to .env.local and fill in real values.
# Never commit .env.local or real keys.
# Set the same names in the Vercel project for Production and Preview.

# ---------------------------------------------------------------------------
# Still to do before this app can run against real services
# ---------------------------------------------------------------------------
# [ ] Create the Supabase project (prefer a Canadian region).
# [ ] Paste NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY from Project Settings → API.
# [ ] In Supabase Auth → URL configuration, allow:
#       http://localhost:3000/auth/callback
#       https://<production-domain>/auth/callback
# [ ] Apply supabase/migrations in order:
#       bash scripts/deploy.sh production --migrate-only
#     That command needs the deploy variables further down, and it only runs from main.
# [ ] Set ADMIN_EMAILS to the staff addresses that may open /dashboard/admin.
# [ ] Create an OpenAI key and paste OPENAI_API_KEY. Speaking and writing calls fail without it.
# [ ] Create a Stripe account. Paste the secret key, publishable key, and webhook signing secret.
#     Point the webhook at https://<production-domain>/api/webhooks/payments.
# [ ] Copy every name in this file into Vercel → Settings → Environment Variables.
# [ ] Add GitHub Actions secrets: VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID,
#     SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, SUPABASE_DB_PASSWORD.
#     SUPABASE_DB_URL can replace the three Supabase secrets. Use the direct database URI, port 5432.
# [ ] From a repo admin account, run: bash scripts/protect-main.sh
# [ ] Create the lesson host at LESSON_ORIGIN. It must not share the parent site's cookie domain.
# [ ] For 1:1 with Amar, share his calendar with a Google service account and paste the three GOOGLE_ variables.
#     Cal.com is not used for 1:1. Apply supabase/migrations/019_private_session_bookings.sql before students book.
# [ ] Choose a video host (Cloudflare Stream or Mux) in the owner's name. No variable exists for it yet.
# [ ] Turn on Supabase backups and run the restore drill in docs/runbook/backups.md.
# [ ] Generate CRON_SECRET and MEDIA_SIGNING_SECRET (openssl rand -hex 32). Use different values in production.

# ---------------------------------------------------------------------------
# Supabase — required for sign-in, dashboard, and saved attempts
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated. Empty means nobody can open the admin pages.
ADMIN_EMAILS=

# Leave false. true shows the listening answer-key panel in local development only.
NEXT_PUBLIC_SHOW_EXAM_ANSWER_KEY=false

# ---------------------------------------------------------------------------
# OpenAI — required for speaking transcription and writing or speaking scores
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SCORING_MODEL=gpt-5.4-mini
OPENAI_WRITING_MODEL=gpt-5.4-mini

# ---------------------------------------------------------------------------
# Stripe — required before a card payment can be taken
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Renewals and refunds still need STRIPE_WEBHOOK_SECRET in .env.local.
# The first payment works without it because the success page confirms the Checkout session.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# App secrets. Generate locally, and use different values in Vercel.
# ---------------------------------------------------------------------------
CRON_SECRET=
MEDIA_SIGNING_SECRET=

# Separate host for lesson iframes. Session cookies stay on the main site.
LESSON_ORIGIN=https://lessons.celpipdecoded.com

# Folder that holds course videos. Not committed.
# Put each course in its own subfolder, or point this at one course folder.
# Lesson files are .mp4, .m4v, .webm, or .mov. A new file shows up as a lesson.
COURSE_VIDEOS_DIR=

# ---------------------------------------------------------------------------
# Google Calendar — 1:1 with Amar
# Leave empty until Amar's Workspace calendar is ready. The booking page,
# the hold, and the payment work without these. When all three are set,
# busy times are hidden and a Meet link is created after payment.
# Share the calendar with the service account as "Make changes to events".
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Cal.com — not used for 1:1. Kept for a later group-class booking tool.
# ---------------------------------------------------------------------------
CAL_API_KEY=
CAL_WEBHOOK_SECRET=

# Optional. Leave empty to skip error reporting.
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Deploy only. Do not uncomment these in .env.local.
# scripts/deploy.sh --sync-env uploads every filled name to Vercel.
# Set them as GitHub Actions secrets, or export them in the shell for a manual deploy.
# ---------------------------------------------------------------------------
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=
