# Toronto Academy Supabase project
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or real keys.

# Public values, safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose this to the browser or client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only. OpenAI transcription and scoring for speaking attempts,
# plus writing evaluation. Never expose these to the browser or client
# components.
OPENAI_API_KEY=your-openai-api-key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SCORING_MODEL=gpt-5.4-mini
OPENAI_WRITING_MODEL=gpt-5.4-mini

# Optional development switch for the mock test player (EXAM-UI-03).
# Set to the string "true" to show the answer key reference panel on the
# Listening part level answer review screens. Leave it out for any normal
# local run and for every deployment: a learner sitting a practice test
# should not be offered the published answer sheet for the part.
# It hides a link, it is not a security boundary. Answer keys are stripped
# on the server before any content reaches the browser regardless.
NEXT_PUBLIC_SHOW_EXAM_ANSWER_KEY=false

# Comma-separated staff emails. Server only. Empty means nobody is staff.
ADMIN_EMAILS=

# Stripe, server only. Card numbers never come to this app.
# Checkout uses Stripe hosted Checkout. The webhook secret verifies Stripe-Signature.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Shared secret for Vercel cron calls to /api/cron/tick.
CRON_SECRET=

# HMAC secret for expiring audio and file links.
MEDIA_SIGNING_SECRET=

# Lesson origin. Cookies on the main site are host-only, so this host
# does not receive the student session.
LESSON_ORIGIN=https://lessons.celpipdecoded.com

# Cal.com, in the business owner's account.
CAL_API_KEY=
CAL_WEBHOOK_SECRET=

# Optional error reporting. Do not send raw answers or email addresses.
SENTRY_DSN=
