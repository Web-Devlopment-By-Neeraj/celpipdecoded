# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private visual references (EXAM-UI-03)
#
# Screenshots of the real CELPIP practice test are used as private layout
# reference while a screen is being built. They are copyrighted material
# belonging to the test provider and must never reach the repository, so
# the folder they live in is ignored rather than trusted to a reviewer
# spotting it in a diff.
/_reference/
