{
  "name": "georgoacademy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "bash scripts/deploy.sh",
    "deploy:preview": "bash scripts/deploy.sh preview",
    "deploy:production": "bash scripts/deploy.sh production",
    "db:push": "bash scripts/deploy.sh production --migrate-only",
    "videos:upload": "node scripts/upload-instructional-videos.mjs",
    "prepare": "husky",
    "assets:audit": "node scripts/audit-and-optimize-assets.mjs --audit",
    "assets:optimize": "node scripts/audit-and-optimize-assets.mjs --optimize",
    "assets:normalize-badges": "node scripts/normalize-badge-icon-assets.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.109.0",
    "next": "16.2.9",
    "openai": "^6.45.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
